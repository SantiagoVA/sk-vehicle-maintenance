# Copy this file to .env and fill in real values. Never commit .env.

# --------------------------------------------------------------- SERVER --
PORT=4000
# Comma-separated list of origins allowed to call this API (your site's URL).
# For local dev with `python3 -m http.server 8000` on the frontend:
CORS_ORIGIN=http://localhost:8000

# ------------------------------------------------------------- DATABASE --
# Local development (default): SQLite, zero setup, stored as a file.
DATABASE_CLIENT=better-sqlite3
DATABASE_URL=./data/bookings.sqlite3

# Cloud/production: switch to Postgres by changing these two lines to
# whatever your host gives you (Render, Railway, Supabase, Neon, RDS...):
# DATABASE_CLIENT=pg
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------------------------------------------------------- META WHATSAPP CLOUD API --
# Get these from developers.facebook.com -> Your App -> WhatsApp -> API Setup
META_ACCESS_TOKEN=EAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=123456789012345

# The custom verify token you set when configuring the Webhook in the Meta dashboard
META_VERIFY_TOKEN=my_secret_verify_token_123

# Authorized staff/owner WhatsApp numbers (where new booking requests get sent
# and who are allowed to confirm/decline), comma-separated in international format
# without '+' or spaces. e.g., 61481119280,61400111222
OWNER_WHATSAPP_NUMBERS=61481119280
# Legacy single-number fallback (also supported):
# OWNER_WHATSAPP_NUMBER=61481119280

# ----------------------------------------------------------------- MISC --
# How many vehicles the workshop can handle simultaneously at any time slot.
MAX_CONCURRENT_BOOKINGS=3

# How long a booking stays "pending" before its slot is released back to
# availability if no staff member confirms/declines it.
PENDING_TTL_MINUTES=30

# How many hours before a confirmed appointment to send a WhatsApp reminder.
REMINDER_HOURS_BEFORE=6

# IANA timezone of the workshop (recommended in cloud/UTC hosting, e.g. Australia/Perth).
# Leave empty/commented to use the server's local timezone.
WORKSHOP_TIMEZONE=Australia/Perth
